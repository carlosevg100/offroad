{
  "name": "@offroad/release-governance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**'",
    "program-board:render": "node --experimental-strip-types scripts/render-endgame-program-board.ts",
    "evidence-registry:render": "tsx scripts/render-evidence-registry.ts"
  },
  "dependencies": {
    "@offroad/case-runner": "workspace:*",
    "@offroad/case-understanding": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "4.23.12"
  }
}

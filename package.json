{
  "name": "offroad",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "next": "16.3.3",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.7",
      "sharp": "0.35.4",
      "js-yaml": "4.3.2",
      "@vitest/mocker": "4.1.11"
    }
  }
}

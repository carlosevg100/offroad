{
  "region": "sa-east-1",
  "logGroup": "/ecs/offroad-document-worker",
  "namespace": "Offroad/DocumentWorker",
  "filters": [
    {"name": "offroad-outbox-heartbeat", "pattern": "{ $.event = \"outbox.health\" }", "metric": "OutboxHeartbeat", "value": "1"},
    {"name": "offroad-outbox-pending-age", "pattern": "{ $.event = \"outbox.health\" }", "metric": "OutboxOldestPendingSeconds", "value": "$.oldestPendingSeconds"},
    {"name": "offroad-outbox-blocked", "pattern": "{ $.event = \"outbox.health\" }", "metric": "OutboxBlockedCount", "value": "$.blockedCount"},
    {"name": "offroad-outbox-errors", "pattern": "{ ($.event = \"outbox.poll.failed\") || ($.event = \"outbox.complete.failed\") }", "metric": "OutboxErrors", "value": "1"}
  ],
  "alarms": [
    {"name": "offroad-outbox-heartbeat-missing", "metric": "OutboxHeartbeat", "comparison": "LessThanThreshold", "threshold": 1, "statistic": "Sum", "periods": 3, "missing": "breaching"},
    {"name": "offroad-outbox-backlog", "metric": "OutboxOldestPendingSeconds", "comparison": "GreaterThanThreshold", "threshold": 300, "statistic": "Maximum", "periods": 2, "missing": "missing"},
    {"name": "offroad-outbox-blocked", "metric": "OutboxBlockedCount", "comparison": "GreaterThanThreshold", "threshold": 0, "statistic": "Maximum", "periods": 1, "missing": "missing"},
    {"name": "offroad-outbox-errors", "metric": "OutboxErrors", "comparison": "GreaterThanThreshold", "threshold": 0, "statistic": "Sum", "periods": 1, "missing": "notBreaching"}
  ]
}

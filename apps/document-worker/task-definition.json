{
  "family": "offroad-document-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "2048",
  "memory": "4096",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::389642461544:role/offroadEcsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::389642461544:role/offroadDocumentWorkerTaskRole",
  "containerDefinitions": [
    {
      "name": "document-worker",
      "image": "IMAGE_PLACEHOLDER",
      "essential": true,
      "stopTimeout": 120,
      "environment": [
        {
          "name": "DOCUMENTARY_WORK_PLANNING_ENABLED",
          "value": "false"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "SUPABASE_URL",
          "value": "https://ifnogpksgdadruooqydi.supabase.co"
        },
        {
          "name": "PIPELINE_VERSION",
          "value": "f2-2026.08.24"
        },
        {
          "name": "LEASE_SECONDS",
          "value": "600"
        },
        {
          "name": "HEARTBEAT_SECONDS",
          "value": "120"
        },
        {
          "name": "IDLE_POLL_SECONDS",
          "value": "5"
        },
        {
          "name": "MAX_CONCURRENT_JOBS",
          "value": "1"
        },
        {
          "name": "REQUIRE_VIRUS_SCAN",
          "value": "true"
        },
        {
          "name": "OCR_LANGUAGES",
          "value": "por+eng"
        },
        {
          "name": "MODEL_MAX_CALLS_PER_JOB",
          "value": "8"
        },
        {
          "name": "ENABLE_OPENAI_WEB_SEARCH",
          "value": "true"
        },
        {
          "name": "ENABLE_FIRECRAWL",
          "value": "true"
        },
        {
          "name": "FIRECRAWL_ZERO_DATA_RETENTION",
          "value": "false"
        },
        {
          "name": "LOG_LEVEL",
          "value": "info"
        },
        {
          "name": "SOURCE_PACKS_DIR",
          "value": "/app/source-packs"
        },
        {
          "name": "PROVIDER_CONNECTIONS_JSON",
          "value": "{\"openai\":{\"accountRef\":\"org-RduRuVoprBl49gwbfIMNQVH3\",\"projectRef\":\"proj_Lq9xdWylMavwBEfHbNxJMSHF\",\"credentialBinding\":\"1e0aa91f-5bad-4f46-8363-241381e647dc\",\"region\":\"global\"},\"anthropic\":{\"accountRef\":\"6189245d-6371-40a7-a470-aa38ce58a754\",\"projectRef\":\"wrkspc_01FviSqikt1RDKdtbfZsmCfT\",\"credentialBinding\":\"122470d2-ece8-4467-8a03-36f01d57761a\",\"region\":\"global\"}}"
        }
      ],
      "secrets": [
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "offroad/anthropic-api-key",
          "versionId": "122470d2-ece8-4467-8a03-36f01d57761a"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "offroad/openai-api-key",
          "versionId": "1e0aa91f-5bad-4f46-8363-241381e647dc"
        },
        {
          "name": "PERPLEXITY_API_KEY",
          "valueFrom": "offroad/perplexity-api-key"
        },
        {
          "name": "FIRECRAWL_API_KEY",
          "valueFrom": "offroad/firecrawl-api-key"
        },
        {
          "name": "SUPABASE_PUBLISHABLE_KEY",
          "valueFrom": "offroad/supabase-publishable-key"
        },
        {
          "name": "WORKER_ACCOUNT_EMAIL",
          "valueFrom": "offroad/worker-account-email"
        },
        {
          "name": "WORKER_ACCOUNT_PASSWORD",
          "valueFrom": "offroad/worker-account-password"
        },
        {
          "name": "OFFROAD_WORKER_TOKEN",
          "valueFrom": "offroad/worker-token"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/offroad-document-worker",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}

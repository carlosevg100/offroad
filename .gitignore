# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
.turbo/
dist/
coverage/
playwright-report/
test-results/

# Environment and local provider state
.env
.env.*
!.env.example
.vercel/
.supabase/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
pnpm-debug.log*
.env*.local

# Measurement output (real model runs; never committed)
packages/evals/out/
.gstack/

# Intermediários da FakeCo: o gerador os reproduz, o renderizador os consome.
packages/testing-fixtures/assets/fakeco/.html/
packages/testing-fixtures/assets/fakeco/.build.json

# Text corpus derived from the frozen packs for AI reviews; only its manifest is committed
docs/product/gold-cases/runs/*/ai-review-corpus/*
!docs/product/gold-cases/runs/*/ai-review-corpus/manifest.json

# Public application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR

# Supabase - populate through environment secret stores, never commit real values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Observability - intentionally unset until privacy policies and projects exist
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Document pipeline (P1 F1-4) -----------------------------------------------
# There is no environment variable for this. Which extractor an organization gets is decided
# per organization, in the database (`organizations.pipeline_enabled`, off by default and not
# writable through the Data API), because promotion is gradual and reversible and should never
# require a deployment.

# --- Document worker (P1 F1-3) -------------------------------------------------
# Names only. The values live exclusively in the deployment secret store (AWS Secrets
# Manager for the worker, `sa-east-1`), are injected by the task definition at start-up,
# and must never be written to a file in this repository or pasted into a chat, an issue
# or a PR. A key that reaches any of those is considered exposed and must be rotated
# (AGENTS.md §3).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
FIRECRAWL_API_KEY=
# Paid fallbacks stay disabled even when a general provider credential exists. Enable only after
# contract, retention policy, budget and gold-case checks have been approved.
ENABLE_OPENAI_WEB_SEARCH=false
ENABLE_FIRECRAWL=false
# Public-source acquisition can run with cache disabled on self-serve plans. Set this to true only
# after Firecrawl has enabled its Enterprise ZDR capability for the Offroad account.
FIRECRAWL_ZERO_DATA_RETENTION=false
OFFROAD_RESEARCH_USER_AGENT=Offroad Capital research@offroad.capital
# Hashed worker credential from private.worker_tokens; the plaintext exists only here.
OFFROAD_WORKER_TOKEN=
